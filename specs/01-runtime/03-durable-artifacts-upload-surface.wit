package chunky:runtime;

/// A caller-owned finite one-shot byte source.
interface artifact-byte-source {
  record source-error {
    message: string,
  }

  variant source-read {
    bytes(list<u8>),
    end-of-source,
  }

  resource artifact-byte-source {
    read-up-to: func(max-byte-length: u64) -> result<source-read, source-error>;
  }
}

/// Caller-facing durable publication of immutable exact content bytes.
interface durable-artifacts-upload {
  use artifact-byte-source.{artifact-byte-source};
  use failure-surface.{failure};
  use time-formats.{absolute-time, duration};

  /// Caller-supplied algorithm identifier. Runtime policy determines which
  /// identifiers may be used for caller-defined content identity.
  type content-id-algorithm = string;

  record content-id {
    algorithm: content-id-algorithm,
    /// Canonical value for the selected content-ID algorithm.
    value: string,
  }

  /// Integrity-digest algorithms are independent of content-ID algorithms.
  type content-digest-algorithm = string;

  record content-digest {
    algorithm: content-digest-algorithm,
    value: string,
  }

  record durable-content-upload-result {
    content-id: content-id,
    grace-retained-until: absolute-time,
    retention-deadline: option<absolute-time>,
    byte-length: u64,
  }

  enum source-disposition {
    preserve,
    consume,
  }

  // -----------------------------------------------------------------------
  // DIRECT PUBLICATION

  publish-content-bytes: func(
    content-bytes: list<u8>,
    desired-grace-ttl: duration,
    desired-retention-ttl: option<duration>,
    content-id: option<content-id>,
    expected-content-digest: option<content-digest>,
  ) -> result<durable-content-upload-result, failure>;

  publish-content-source: func(
    byte-source: own<artifact-byte-source>,
    total-byte-length: option<u64>,
    desired-grace-ttl: duration,
    desired-retention-ttl: option<duration>,
    content-id: option<content-id>,
    expected-content-digest: option<content-digest>,
  ) -> result<durable-content-upload-result, failure>;

  publish-content-file: func(
    path: string,
    source-disposition: option<source-disposition>,
    desired-grace-ttl: duration,
    desired-retention-ttl: option<duration>,
    content-id: option<content-id>,
    expected-content-digest: option<content-digest>,
  ) -> result<durable-content-upload-result, failure>;

  // -----------------------------------------------------------------------
  // RESUMABLE FIXED-PART UPLOAD

  type upload-session-id = string;

  enum content-upload-state {
    reserved,
    receiving,
    received,
    finalizing,
    committed,
    aborted,
    timed-out,
    failed,
  }

  record content-upload-plan {
    upload-session-id: upload-session-id,
    part-size: u64,
    part-count: u32,
    inactivity-timeout: duration,
    inactivity-deadline: absolute-time,
  }

  record accepted-upload-part {
    part-number: u32,
    content-digest: option<content-digest>,
  }

  record content-upload-status {
    upload-session-id: upload-session-id,
    state: content-upload-state,
    inactivity-timeout: duration,
    inactivity-deadline: absolute-time,
    expected-byte-length: u64,
    received-byte-length: u64,
    outstanding-parts: list<u32>,
    publication-result: option<durable-content-upload-result>,
  }

  begin-content-upload: func(
    total-byte-length: u64,
    desired-inactivity-timeout: option<duration>,
    desired-grace-ttl: duration,
    desired-retention-ttl: option<duration>,
    content-id: option<content-id>,
    expected-content-digest: option<content-digest>,
  ) -> result<content-upload-plan, failure>;

  upload-content-part: func(
    upload-session-id: upload-session-id,
    part-number: u32,
    byte-source: own<artifact-byte-source>,
    expected-content-digest: option<content-digest>,
  ) -> result<accepted-upload-part, failure>;

  get-content-upload: func(
    upload-session-id: upload-session-id,
  ) -> result<content-upload-status, failure>;

  commit-content-upload: func(
    upload-session-id: upload-session-id,
  ) -> result<durable-content-upload-result, failure>;

  abort-content-upload: func(
    upload-session-id: upload-session-id,
  ) -> result<_, failure>;

  // -----------------------------------------------------------------------
  // LIVE CAPTURE OF ONE FINITE CONTENT OBJECT

  type capture-session-id = string;

  record accepted-live-capture-segment {
    capture-session-id: capture-session-id,
    inactivity-deadline: absolute-time,
    received-byte-length: u64,
  }

  record live-capture-status {
    capture-session-id: capture-session-id,
    state: content-upload-state,
    inactivity-timeout: duration,
    inactivity-deadline: absolute-time,
    received-byte-length: u64,
    publication-result: option<durable-content-upload-result>,
  }

  begin-live-capture: func(
    initial-byte-source: option<own<artifact-byte-source>>,
    desired-inactivity-timeout: option<duration>,
    desired-grace-ttl: duration,
    desired-retention-ttl: option<duration>,
  ) -> result<accepted-live-capture-segment, failure>;

  append-live-capture-segment: func(
    capture-session-id: capture-session-id,
    byte-source: own<artifact-byte-source>,
  ) -> result<accepted-live-capture-segment, failure>;

  get-live-capture: func(
    capture-session-id: capture-session-id,
  ) -> result<live-capture-status, failure>;

  complete-live-capture: func(
    capture-session-id: capture-session-id,
    final-byte-source: option<own<artifact-byte-source>>,
    total-byte-length: option<u64>,
  ) -> result<durable-content-upload-result, failure>;

  abort-live-capture: func(
    capture-session-id: capture-session-id,
  ) -> result<_, failure>;
}
