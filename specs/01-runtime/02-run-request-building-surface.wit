package chunky:runtime;

/// Caller-facing construction of local and durable run requests.
interface run-request-building {
  use failure-surface.{failure};
  use time-formats.{positive-duration};

  /// Canonical arbitrary-depth hierarchy ending in `{domain}/{content-kind}`.
  /// The final two segments are the ArtifactRequest; any preceding segments
  /// are semantic binding scopes. No producer or schema suffix is permitted.
  type scoped-artifact-request = string;

  enum content-id-algorithm {
    blake3,
  }

  /// Universal exact-byte identity. `value` is canonical unpadded Base64URL.
  record content-id {
    algorithm: content-id-algorithm,
    value: string,
  }

  /// Ordinal MUST equal list position in its enclosing binding.
  record supplied-artifact-member {
    ordinal: u32,
    content-id: content-id,
  }

  /// Canonical supplied binding. `members` MUST be non-empty.
  record supplied-artifact-binding {
    request: scoped-artifact-request,
    members: list<supplied-artifact-member>,
  }

  enum artifact-cache-behavior {
    inherited,
    cache,
    no-cache,
    refresh,
    read-only,
  }

  record artifact-cache-policy {
    behavior: artifact-cache-behavior,
    desired-ttl: option<positive-duration>,
  }

  record task-cache-policy {
    behavior: artifact-cache-behavior,
    max-ttl: option<positive-duration>,
  }

  /// Output request envelope. `request` is also the task-result correlation
  /// key. There is intentionally no caller-chosen output key.
  record requested-artifact-output {
    request: scoped-artifact-request,
    cache-policy: option<artifact-cache-policy>,
  }

  record artifact-cache-policy-entry {
    request: scoped-artifact-request,
    policy: artifact-cache-policy,
  }

  enum resource-constraint {
    vram,
    ram,
    gpu,
    cpu,
  }

  record constraint-concurrency-limit {
    constraint: resource-constraint,
    limit: u32,
  }

  enum publication-mode {
    default,
    at-completion,
    incremental,
  }

  record run-policy {
    prevent-concurrency: bool,
    constraint-concurrency-limits: list<constraint-concurrency-limit>,
    publication-mode: publication-mode,
  }

  /// Immutable, canonical, data-only durable computation request.
  record durable-run-request {
    version: u32,
    inputs: list<supplied-artifact-binding>,
    outputs: list<requested-artifact-output>,
    artifact-retention-ttl: option<positive-duration>,
    run-policy: option<run-policy>,
    task-cache-policy: option<task-cache-policy>,
    cache-policy: list<artifact-cache-policy-entry>,
  }

  /// Unvalidated DTOs preserve issue context during aggregate validation.
  record input-member-dto {
    ordinal: u32,
    content-id: string,
  }

  record supplied-binding-dto {
    request: string,
    members: list<input-member-dto>,
  }

  record requested-output-dto {
    request: string,
    cache-policy: option<artifact-cache-policy>,
  }

  record cache-policy-entry-dto {
    request: string,
    policy: artifact-cache-policy,
  }

  record durable-run-request-dto {
    version: u32,
    inputs: list<supplied-binding-dto>,
    outputs: list<requested-output-dto>,
    artifact-retention-ttl: option<positive-duration>,
    run-policy: option<run-policy>,
    task-cache-policy: option<task-cache-policy>,
    cache-policy: list<cache-policy-entry-dto>,
  }

  resource artifact-source-handle;
  resource artifact-target-handle;
  resource local-run-request;

  resource local-run-request-builder {
    constructor();

    /// One complete canonical path may be declared once. Use the plural
    /// operation to establish member order explicitly.
    include-input: func(
      request: string,
      source: own<artifact-source-handle>,
    );

    include-input-members: func(
      request: string,
      sources: list<own<artifact-source-handle>>,
    );

    /// Binds already-published content without selecting a schema.
    include-content-binding: func(
      request: string,
      members: list<input-member-dto>,
    );

    /// Repeated targets for one output are ordered delivery fan-out, not
    /// artifact-member cardinality.
    expect-output-target: func(
      request: string,
      target: own<artifact-target-handle>,
    );

    expect-output: func(request: string);
    with-run-policy: func(policy: run-policy);
    with-task-cache-policy: func(policy: task-cache-policy);
    with-artifact-cache-policy: func(
      request: string,
      policy: artifact-cache-policy,
    );

    build: func() -> result<own<local-run-request>, failure>;
    close: func();
  }

  resource durable-run-request-builder {
    constructor();

    from-object: static func(
      request: durable-run-request-dto,
    ) -> result<own<durable-run-request-builder>, failure>;

    /// No I/O occurs here. Task acceptance later verifies and atomically
    /// protects every member before creating a task.
    include-content-binding: func(
      request: string,
      members: list<input-member-dto>,
    );

    expect-output: func(request: string);
    with-artifact-retention-ttl: func(ttl: positive-duration);
    with-run-policy: func(policy: run-policy);
    with-task-cache-policy: func(policy: task-cache-policy);
    with-artifact-cache-policy: func(
      request: string,
      policy: artifact-cache-policy,
    );

    build: func() -> result<durable-run-request, failure>;
  }
}
